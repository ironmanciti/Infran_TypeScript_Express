# 도서 API 테스트 요청 모음 (VS Code REST Client 확장)
# 대상: main.ts + books-router.ts + error-handler.ts
# 먼저 서버 실행: 저장소 루트에서 npm run dev:server
# 각 요청 위의 "Send Request"를 눌러 실행합니다.
# 기대 id는 서버를 막 켠 뒤 위에서부터 차례로 실행했을 때 기준입니다.
# 도서 배열은 메모리에만 있어서 서버가 재시작되면 처음 2권(id 1, 2)으로 돌아갑니다.

@baseUrl = http://localhost:3000

### ===== GET /books: 목록 =====

### 1. 목록 조회 → 200, 도서 2권
GET {{baseUrl}}/books

### ===== POST /books: 추가 =====

### 2. 도서 추가 → 201, id 3 (응답을 createBook으로 저장해 아래에서 사용)
# @name createBook
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "  Node.js 기초  ",
  "author": "이영희",
  "price": 20000
}

### 3. 본문의 id는 버려지고 서버가 붙인 id 사용 → 201, id 4 (999 아님)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "id": 999,
  "title": "React 입문",
  "author": "박민수",
  "price": 28000
}

### 4. 추가 후 목록 → 200, 4권 (2번의 title은 공백이 제거된 "Node.js 기초")
GET {{baseUrl}}/books

### ===== GET /books/:id: 한 권 조회 =====

### 5. 기존 도서 조회 → 200, id 1 도서
GET {{baseUrl}}/books/1

### 6. 방금 추가한 도서 조회 → 200, id 3 도서
GET {{baseUrl}}/books/{{createBook.response.body.$.id}}

### 7. 없는 id → 404, {"message":"id 999인 도서를 찾을 수 없습니다"}
GET {{baseUrl}}/books/999

### 8. 숫자가 아닌 id → 404, {"message":"id abc인 도서를 찾을 수 없습니다"}
GET {{baseUrl}}/books/abc

### ===== DELETE /books/:id: 삭제 =====

### 9. 2번에서 추가한 도서 삭제 → 204, 본문 없음
DELETE {{baseUrl}}/books/{{createBook.response.body.$.id}}

### 10. 같은 id 다시 삭제 → 404, {"message":"id 3인 도서를 찾을 수 없습니다"}
DELETE {{baseUrl}}/books/{{createBook.response.body.$.id}}

### 11. 삭제한 도서 조회 → 404
GET {{baseUrl}}/books/{{createBook.response.body.$.id}}

### 12. 삭제 후 추가 → 201, id 5 (지워진 3을 다시 쓰지 않음)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "삭제 후 추가",
  "author": "정하늘",
  "price": 15000
}

### ===== 검증 실패 (Zod → errorHandler) → 400, errors에 필드별 이유 =====

### 13. title이 공백뿐 → 400, title: "title은 1자 이상이어야 합니다"
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "   ",
  "author": "최지우",
  "price": 10000
}

### 14. title이 101자 → 400, title: "title은 100자 이하여야 합니다"
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "author": "최지우",
  "price": 10000
}

### 15. author 누락 → 400, author: "author는 필수 문자열입니다"
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "저자 없음",
  "price": 10000
}

### 16. price가 0 → 400, price: "price는 양수여야 합니다"
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "무료 도서",
  "author": "최지우",
  "price": 0
}

### 17. price가 문자열 → 400, price: "price는 숫자여야 합니다"
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "가격 오류",
  "author": "최지우",
  "price": "비쌈"
}

### 18. 빈 객체 → 400, title·author·price 오류가 모두 담김
POST {{baseUrl}}/books
Content-Type: application/json

{}

### ===== 그 밖의 오류 =====

### 19. 깨진 JSON → 400, {"message":"Unexpected end of JSON input"}
POST {{baseUrl}}/books
Content-Type: application/json

{"title":

### 20. Content-Type 헤더 없음 → 400, errors는 빈 객체 (req.body가 undefined)
POST {{baseUrl}}/books

{"title":"제목만"}

### 21. 없는 경로 → 404, HTML "Cannot GET /nope" (404 처리 미들웨어 없음)
GET {{baseUrl}}/nope

### 22. 지원하지 않는 메서드 → 404, HTML "Cannot DELETE /books"
DELETE {{baseUrl}}/books

### ===== id별 조회 / 삭제 (처음부터 있던 도서 id 1, 2) =====

### 23. id 1 조회 → 200, "타입스크립트 입문"
GET {{baseUrl}}/books/1

### 24. id 2 조회 → 200, "Express 실전"
GET {{baseUrl}}/books/2

### 25. id 1 삭제 → 204, 본문 없음
DELETE {{baseUrl}}/books/1

### 26. 삭제한 id 1 조회 → 404, {"message":"id 1인 도서를 찾을 수 없습니다"}
GET {{baseUrl}}/books/1

### 27. id 2 삭제 → 204, 본문 없음
DELETE {{baseUrl}}/books/2

### 28. 삭제한 id 2 다시 삭제 → 404, {"message":"id 2인 도서를 찾을 수 없습니다"}
DELETE {{baseUrl}}/books/2

### 29. 삭제 후 목록 → 200, id 1·2가 빠진 목록
GET {{baseUrl}}/books
