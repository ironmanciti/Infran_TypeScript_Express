{
  "compilerOptions": {
    "target": "ES2023",             // 변환 결과의 JavaScript 문법 버전
    "module": "ESNext",             // 최신 import/export 문법 그대로
    "moduleResolution": "bundler",  // Vite 같은 번들러의 import 경로 규칙
    "lib": ["ES2023", "DOM", "DOM.Iterable"], // 브라우저 API 타입 (document 등)
    "strict": true,                 // 엄격한 타입 검사 (null 검사 포함)
    "verbatimModuleSyntax": true,   // 타입만 가져올 때 import type 필수
    "skipLibCheck": true,           // 라이브러리 .d.ts 검사 생략 (속도)
    "noEmit": true,                 // JavaScript 변환은 Vite가 하므로 tsc는 검사만
    "types": ["vite/client"]        // Vite가 제공하는 타입 (import.meta.env 등)
  },
  "include": ["src/**/*.ts", "vite.config.ts"] // 검사 대상
}
